{
  "name": "when2watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:http": "node scripts/smoke-http.mjs",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "test:db:up": "docker run -d --rm --name w2w-test-pg -e POSTGRES_PASSWORD=w2w-local-test -p 127.0.0.1:55432:5432 postgres:17",
    "test:db:down": "docker stop w2w-test-pg",
    "migrate:export": "tsx scripts/migration/sqlite-export.ts",
    "migrate:import": "tsx scripts/migration/import-postgres.ts",
    "migrate:verify": "tsx scripts/migration/verify-import.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "6.19.3",
    "google-auth-library": "11.1.0",
    "html-to-text": "10.0.1",
    "next": "16.3.6",
    "next-auth": "4.24.15",
    "prisma": "6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild": true,
    "sharp": true,
    "fsevents": false
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "devDependencies": {
    "@types/html-to-text": "9.0.4",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
