generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  calendar      CalendarSettings?
  probes        Probe[]
  shows         TrackedShow[]
  syncRuns      SyncRun[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  refresh_token_expires_in Int?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  needsReauth       Boolean @default(false)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CalendarSettings {
  userId               String   @id
  calendarId           String
  summary              String
  timeZone             String
  accessRole           String
  defaultRemindersJson String
  confirmedAt          DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Probe {
  id           String   @id @default(cuid())
  userId       String
  calendarId   String
  eventId      String   @unique
  date         String
  status       String   @default("prepared")
  requestJson  String
  readbackJson String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model TrackedShow {
  id            String @id @default(cuid())
  userId        String
  tvmazeId      Int
  title         String
  sourceUrl     String
  year          String?
  poster        String?
  platform      String?
  country       String?
  status        String
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  lastError     String?
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodes      Episode[]
  @@unique([userId, tvmazeId])
}

model Episode {
  id            String @id @default(cuid())
  trackedShowId String
  sourceId      Int
  title         String?
  season        Int?
  number        Int?
  airdate       String?
  sourceUrl     String
  present       Boolean @default(true)
  show          TrackedShow @relation(fields: [trackedShowId], references: [id], onDelete: Cascade)
  links         CalendarEventLink[]
  @@unique([trackedShowId, sourceId])
}

model CalendarEventLink {
  id                   String @id @default(cuid())
  episodeId            String
  calendarId           String
  eventId              String @unique
  status               String @default("prepared")
  desiredJson          String
  confirmedDesiredHash String?
  confirmedRemoteHash  String?
  lastDate             String?
  episode              Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  @@unique([episodeId, calendarId])
}

model SyncRun {
  id         String @id @default(cuid())
  userId     String
  trigger    String
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  status     String @default("running")
  resultJson String?
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, startedAt])
}
